HF_TOKEN=

# ── Đường dẫn lưu trữ ──────────────────────────────────────
# Output riêng cho lần chạy 2 — không ghi đè lần 1
AEROEYES_MODEL_DIR=/datastore/cndt_khanhnd/models/aeroeyes_model
AEROEYES_OUTPUT_DIR=/datastore/cndt_khanhnd/models/aeroeyes_output_run2

# ── Tham số sinh ảnh (THAY ĐỔI so với lần 1) ───────────────
IMAGE_SIZE=1024
LIMIT_IMAGES=500
BASE_SEED=100          # Lần 1: 50  →  Lần 2: 100
GUIDANCE_SCALE=3.0     # Lần 1: 3.5 →  Lần 2: 3.0 (ít sáng tạo hơn, bám sát ảnh gốc hơn)
NUM_INFERENCE_STEPS=20

# ── SDQM Regression ─────────────────────────────────────────
# ⚠️  QUAN TRỌNG: Điền mAP50 từ YOLOv8 lần 1 vào đây TRƯỚC khi chạy lần 2
# Cách lấy: cat <yolo_run1_dir>/results.csv | tail -1  (cột metrics/mAP50(B))
SDQM_MAP_VALUE=         # ← Điền vào đây: ví dụ SDQM_MAP_VALUE=0.734
SDQM_MAP_COLUMN=map
SDQM_APPEND_HISTORY=true
SDQM_RUN_REGRESSION=true
