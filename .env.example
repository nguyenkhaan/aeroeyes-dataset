HF_TOKEN=

# ── Đường dẫn lưu trữ ──────────────────────────────────────
AEROEYES_MODEL_DIR=/datastore/cndt_khanhnd/models/aeroeyes_model
AEROEYES_OUTPUT_DIR=/datastore/cndt_khanhnd/models/aeroeyes_output

# ── Tham số sinh ảnh ────────────────────────────────────────
IMAGE_SIZE=1024
LIMIT_IMAGES=500
BASE_SEED=50
GUIDANCE_SCALE=3.5
NUM_INFERENCE_STEPS=20

# ── SDQM Regression (ghi mAP sau khi train YOLOv8) ─────────
SDQM_MAP_VALUE=
SDQM_MAP_COLUMN=map
SDQM_APPEND_HISTORY=true
SDQM_RUN_REGRESSION=true
